rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL AUTH & RBAC HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserSuspended() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().get('suspended', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token != null && request.auth.token.role == 'admin') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'admin'));
    }

    function isFarmer() {
      return isAuthenticated() && 
        ((request.auth.token != null && request.auth.token.role == 'farmer') ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'farmer'));
    }

    // ==========================================
    // 1. USERS COLLECTION
    // Users can read and write only their own profile.
    // Can NEVER change their own "role" or "suspended" fields.
    // Admins can read all profiles and update any user (e.g. suspend/unsuspend).
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // User can create their profile on registration, but cannot self-assign role 'admin' or suspended status
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.get('role', 'farmer') != 'admin'
        && request.resource.data.get('suspended', false) == false;
      
      // User can update only their own profile, but cannot tamper with 'role' or 'suspended' fields
      allow update: if isAuthenticated() && (
        (isOwner(userId) && 
         request.resource.data.get('role', 'farmer') == resource.data.get('role', 'farmer') && 
         request.resource.data.get('suspended', false) == resource.data.get('suspended', false)) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. MANDI LISTINGS & TRANSPORT OFFERS
    // Anyone can read listings. Only the owner can edit or delete their own listing.
    // Suspended users cannot post. Admins can delete or hide any listing.
    // ==========================================
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && !isUserSuspended();
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && !isUserSuspended()) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 3. WHOLESALER RATINGS & REVIEWS
    // Anyone can read reviews. Only a logged-in non-suspended farmer can create.
    // Farmer can edit their own. Admins can hide or delete.
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && isFarmer()
        && !isUserSuspended()
        && request.resource.data.farmerUid == request.auth.uid
        && request.resource.data.wholesalerUid != request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.farmerUid == request.auth.uid && !isUserSuspended()) ||
        (resource.data.wholesalerUid == request.auth.uid && !isUserSuspended()) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.farmerUid == request.auth.uid || 
        isAdmin()
      );
    }

    // ==========================================
    // 4. FERTILIZER PRICES (MASTER DATA)
    // Anyone can read, only admins can edit price tables.
    // ==========================================
    match /fertilizerPrices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. TRACTORS (MASTER DATA)
    // Anyone can read, only admins can edit.
    // ==========================================
    match /tractors/{tractorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. REPORTS (LISTINGS & REVIEWS)
    // Anyone logged in can create a report, but only admins can read reports.
    // ==========================================
    match /reportedListings/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /reportedReviews/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 7. CHATS & DIRECT MESSAGES
    // Chats are readable only by their two participants.
    // Suspended users cannot post or chat.
    // ==========================================
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() 
        && request.resource.data.senderId == request.auth.uid
        && !isUserSuspended();
      allow update, delete: if isAdmin();
    }

    match /conversations/{convId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants &&
        !isUserSuspended()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 8. ADMIN AUDIT LOGS
    // Only admins can read or create audit records.
    // ==========================================
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // 9. FARM LEDGER RECORDS (PRODUCE, EXPENSES, INCOME, PLANS)
    // ==========================================
    match /produce/{recordId} {
      allow read, write: if isAuthenticated() && (
        (resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /expenses/{recordId} {
      allow read, write: if isAuthenticated() && (
        (resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /income/{recordId} {
      allow read, write: if isAuthenticated() && (
        (resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /cropPlans/{planId} {
      allow read, write: if isAuthenticated() && (
        (resource == null ? request.resource.data.userId == request.auth.uid : resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
